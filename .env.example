# Copy this file to .env.local and replace the placeholder values with the Firebase config for your project.
# Never commit real secrets or API keys to Git.
VITE_FIREBASE_API_KEY="PASTE_NEW_FIREBASE_WEB_API_KEY_HERE"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_APP_ID="1:123456789:web:your-app-id"
VITE_FIREBASE_VAPID_KEY="PASTE_FIREBASE_WEB_PUSH_CERTIFICATE_KEY_HERE"
