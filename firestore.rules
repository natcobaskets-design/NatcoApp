rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminPath() {
      return /databases/$(database)/documents/admin_users/$(request.auth.uid);
    }

    function isAdmin() {
      return signedIn()
        && exists(adminPath())
        && get(adminPath()).data.active == true;
    }

    function authEmail() {
      return request.auth.token.get('email', '');
    }

    function authPhone() {
      return request.auth.token.get('phone_number', '');
    }

    function phoneLookupPath() {
      return /databases/$(database)/documents/employee_phone_lookup/$(authPhone());
    }

    function employeeAuthLookupPath() {
      return /databases/$(database)/documents/employee_auth_lookup/$(authEmail());
    }

    function rosterPathFor(email) {
      return /databases/$(database)/documents/employee_roster/$(email);
    }

    function hasEmployeePasswordAlias() {
      return signedIn()
        && authEmail() is string
        && authEmail().matches('^employee\\.[0-9]{8,15}@[^@]+\\.firebaseapp\\.com$');
    }

    function validEmployeePasswordLookup(lookup) {
      let phoneDigits = lookup.get('phoneDigits', '');
      return lookup.get('authEmail', '') == authEmail()
        && lookup.get('email', '') is string
        && lookup.get('phoneNumber', '') is string
        && phoneDigits is string
        && phoneDigits.matches('^[0-9]{8,15}$')
        && lookup.get('phoneNumber', '') == '+' + phoneDigits
        && authEmail().matches(
          '^employee\\.' + phoneDigits + '@[^@]+\\.firebaseapp\\.com$'
        );
    }

    function hasEmployeePasswordLogin() {
      let lookupPath = employeeAuthLookupPath();
      return hasEmployeePasswordAlias()
        && exists(lookupPath)
        && validEmployeePasswordLookup(get(lookupPath).data);
    }

    function employeeEmail() {
      return hasEmployeePasswordAlias()
        ? get(employeeAuthLookupPath()).data.email
        : authEmail() is string && authEmail() != ''
          ? authEmail()
          : get(phoneLookupPath()).data.email;
    }

    function rosterPath() {
      return rosterPathFor(employeeEmail());
    }

    function hasPhoneLookup() {
      return signedIn()
        && authPhone() is string
        && authPhone().matches('^\\+[1-9][0-9]{7,14}$')
        && exists(phoneLookupPath())
        && get(phoneLookupPath()).data.phoneNumber == authPhone()
        && get(phoneLookupPath()).data.email is string;
    }

    function hasVerifiedEmail() {
      return signedIn()
        && authEmail() is string
        && authEmail() != ''
        && request.auth.token.get('email_verified', false) == true;
    }

    function isApprovedEmployeeForEmail(email) {
      let path = rosterPathFor(email);
      return signedIn()
        && exists(path)
        && get(path).data.active == true
        && (hasVerifiedEmail()
          || (hasEmployeePasswordLogin()
            && get(path).data.get('phoneE164', '')
              == get(employeeAuthLookupPath()).data.phoneNumber)
          || (hasPhoneLookup()
            && get(path).data.get('phoneE164', '') == authPhone()));
    }

    function hasActiveRosterEntry() {
      return isApprovedEmployeeForEmail(employeeEmail());
    }

    function isApprovedEmployee() {
      return hasActiveRosterEntry();
    }

    function validBasketCounts(baskets) {
      return baskets is map
        && baskets.keys().hasOnly(['essential', 'family'])
        && baskets.get('essential', 0) is int
        && baskets.get('family', 0) is int
        && baskets.get('essential', 0) >= 0
        && baskets.get('family', 0) >= 0
        && baskets.get('essential', 0) <= 2
        && baskets.get('family', 0) <= 2
        && baskets.get('essential', 0) + baskets.get('family', 0) >= 1
        && baskets.get('essential', 0) + baskets.get('family', 0) <= 2;
    }

    function countBasketSelections(ids, basketId) {
      return (ids.size() > 0 && ids[0] == basketId ? 1 : 0)
        + (ids.size() > 1 && ids[1] == basketId ? 1 : 0);
    }

    function validBasketAt(ids, index) {
      let basketId = ids[index];
      let basketPath = /databases/$(database)/documents/basket_types/$(basketId);
      let selectedCount = countBasketSelections(ids, basketId);
      return basketId is string
        && ((exists(basketPath)
            && get(basketPath).data.active == true
            && get(basketPath).data.maxPerEmployee is int
            && selectedCount <= get(basketPath).data.maxPerEmployee)
          || (!exists(basketPath)
            && basketId in ['essential', 'family']
            && selectedCount <= 2));
    }

    function validBasketSelection(ids, baskets) {
      let settingsPath = /databases/$(database)/documents/admin_settings/basket_selection;
      let maximum = exists(settingsPath)
        ? get(settingsPath).data.get('maxTotalPerEmployee', 2)
        : 2;
      return ids is list
        && ids.size() > 0
        && ids.size() <= 2
        && maximum is int
        && maximum >= 1
        && maximum <= 2
        && ids.size() <= maximum
        && baskets is map
        && baskets.size() > 0
        && baskets.size() <= 10
        && (ids.size() <= 0 || validBasketAt(ids, 0))
        && (ids.size() <= 1 || validBasketAt(ids, 1));
    }

    function validMonthlySpendMutation(uid, oldSpent) {
      let orderId = request.resource.data.lastSpendOrderId;
      let orderPath = /databases/$(database)/documents/orders/$(orderId);
      let orderAfter = getAfter(orderPath).data;
      let priorOrderAmount = exists(orderPath)
        ? get(orderPath).data.get('totalAmount', 0)
        : 0;
      return orderId is string
        && orderAfter.uid == uid
        && orderAfter.status == 'received'
        && orderAfter.totalAmount is number
        && (orderAfter.createdAt == request.time || orderAfter.updatedAt == request.time)
        && orderAfter.profile.get('currentMonthlySpent', 0) == oldSpent
        && request.resource.data.currentMonthlySpent
          == oldSpent + orderAfter.totalAmount - priorOrderAmount
        && request.resource.data.currentMonthlySpent >= 0
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['currentMonthlySpent', 'spendingPeriod', 'lastSpendOrderId']);
    }

    match /admin_users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }

    match /employee_roster/{email} {
      allow get: if isAdmin()
        || (signedIn()
          && employeeEmail() == email
          && (hasVerifiedEmail()
            || (hasEmployeePasswordLogin()
              && resource.data.get('phoneE164', '')
                == get(employeeAuthLookupPath()).data.phoneNumber)
            || (hasPhoneLookup()
              && resource.data.get('phoneE164', '') == authPhone())));
      allow list: if isAdmin();
      allow create: if isAdmin()
        && (!request.resource.data.keys().hasAny(['company'])
          || (request.resource.data.company is string
            && request.resource.data.company.size() > 0
            && request.resource.data.company.size() <= 80))
        && (!request.resource.data.keys().hasAny(['monthlySpendingLimit'])
          || (request.resource.data.monthlySpendingLimit is number
            && request.resource.data.monthlySpendingLimit >= 0
            && request.resource.data.monthlySpendingLimit <= 1000000000))
        && (!request.resource.data.keys().hasAny(['currentMonthlySpent'])
          || (request.resource.data.currentMonthlySpent is number
            && request.resource.data.currentMonthlySpent >= 0
            && request.resource.data.currentMonthlySpent <= 1000000000))
        && (!request.resource.data.keys().hasAny(['spendingPeriod'])
          || (request.resource.data.spendingPeriod is string
            && request.resource.data.spendingPeriod.matches('^[0-9]{4}-[0-9]{2}$')))
        && (!request.resource.data.keys().hasAny(['branch'])
          || (request.resource.data.branch is string
            && request.resource.data.branch.size() <= 80))
        && (!request.resource.data.keys().hasAny(['province'])
          || (request.resource.data.province is string
            && request.resource.data.province.size() <= 80));
      allow update: if isAdmin()
        || (signedIn()
          && employeeEmail() == email
          && resource.data.active == true
          && request.resource.data.get('employeeCode', resource.data.get('employeeCode', ''))
            == resource.data.get('employeeCode', '')
          && request.resource.data.get('company', resource.data.get('company', ''))
            == resource.data.get('company', '')
          && request.resource.data.get('branch', resource.data.get('branch', ''))
            == resource.data.get('branch', '')
          && request.resource.data.get('province', resource.data.get('province', ''))
            == resource.data.get('province', '')
          && request.resource.data.get('monthlySpendingLimit', resource.data.get('monthlySpendingLimit', -1))
            == resource.data.get('monthlySpendingLimit', -1)
          && validMonthlySpendMutation(
            request.auth.uid,
            resource.data.get('currentMonthlySpent', 0)
          ));
      allow delete: if isAdmin();
    }

    match /employee_phone_lookup/{phoneNumber} {
      allow get: if isAdmin()
        || (signedIn() && authPhone() == phoneNumber);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /employee_auth_lookup/{loginEmail} {
      allow get: if isAdmin()
        || (signedIn() && authEmail() == loginEmail);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /employee_signup_requests/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'uid', 'authEmail', 'phoneNumber', 'phoneDigits', 'name',
          'employeeCode', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'authEmail', 'phoneNumber', 'phoneDigits', 'name',
          'employeeCode', 'status', 'createdAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.authEmail == authEmail()
        && request.resource.data.authEmail is string
        && request.resource.data.phoneDigits is string
        && request.resource.data.phoneDigits.matches('^[0-9]{8,15}$')
        && request.resource.data.phoneNumber == '+' + request.resource.data.phoneDigits
        && request.resource.data.phoneNumber.matches('^\\+[1-9][0-9]{7,14}$')
        && request.resource.data.authEmail.matches(
          '^employee\\.' + request.resource.data.phoneDigits
            + '@[^@]+\\.firebaseapp\\.com$'
        )
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.employeeCode is string
        && request.resource.data.employeeCode.size() <= 80
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;
      allow delete: if isAdmin();
    }

    match /employees/{uid} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == uid
          && isApprovedEmployee());
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid
          && isApprovedEmployee()
          && request.resource.data.keys().hasOnly([
            'email', 'name', 'address', 'coordinates', 'phone', 'whatsapp'
          ])
          && request.resource.data.email == employeeEmail()
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120
          && request.resource.data.address is string
          && request.resource.data.address.size() <= 500
          && request.resource.data.coordinates is string
          && request.resource.data.coordinates.size() <= 100
          && request.resource.data.phone is string
          && request.resource.data.phone.size() <= 30
          && request.resource.data.phone == get(rosterPath()).data.get('phone', '')
          && request.resource.data.whatsapp is string
          && request.resource.data.whatsapp.size() <= 30);
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
          && isApprovedEmployee()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'address', 'coordinates', 'whatsapp'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120
          && request.resource.data.address is string
          && request.resource.data.address.size() <= 500
          && request.resource.data.coordinates is string
          && request.resource.data.coordinates.size() <= 100
          && request.resource.data.whatsapp is string
          && request.resource.data.whatsapp.size() <= 30);
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isAdmin() || isApprovedEmployee();
      allow create, update: if isAdmin()
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 900000
        && (!request.resource.data.keys().hasAny(['department'])
          || (request.resource.data.department is string
            && request.resource.data.department in [
              'consumables', 'frozen', 'beverages', 'home-care',
              'baby-care', 'personal-care', 'snacks', 'spices-dates'
            ]))
        && (!request.resource.data.keys().hasAny(['subcategory'])
          || (request.resource.data.subcategory is string
            && request.resource.data.subcategory.size() <= 80))
        && (!request.resource.data.keys().hasAny(['agentPrice'])
          || (request.resource.data.agentPrice is number
            && request.resource.data.agentPrice >= 0
            && request.resource.data.agentPrice <= 1000000000))
        && (!request.resource.data.keys().hasAny(['companyAgentPrices'])
          || (request.resource.data.companyAgentPrices is map
            && request.resource.data.companyAgentPrices.size() <= 50));
      allow delete: if isAdmin();
    }

    match /catalog_sync_queue/{productId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll([
          'productId', 'action', 'status', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'productId', 'action', 'status', 'updatedAt'
        ])
        && request.resource.data.productId == productId
        && request.resource.data.action in ['upsert', 'deleted']
        && request.resource.data.status == 'pending'
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    function validOrderCreate(orderId) {
      let order = request.resource.data;
      let email = employeeEmail();
      let employeePath = rosterPathFor(email);
      let roster = get(employeePath).data;
      let afterRoster = getAfter(employeePath).data;
      let profile = order.profile;
      let oldSpent = roster.get('currentMonthlySpent', 0);
      let totalAmount = order.get('totalAmount', -1);
      let validBaskets = order.keys().hasAny(['basketSelections'])
        ? validBasketSelection(order.basketSelections, order.baskets)
        : validBasketCounts(order.baskets);
      return isApprovedEmployee()
        && order.keys().hasAll([
          'reference', 'uid', 'email', 'employeeCode', 'profile',
          'baskets', 'items', 'itemDetails', 'excluded',
          'status', 'createdAt', 'updatedAt'
        ])
        && order.keys().hasOnly([
          'reference', 'uid', 'email', 'employeeCode', 'profile',
          'baskets', 'items', 'itemDetails', 'excluded', 'status',
          'createdAt', 'updatedAt', 'pickupBranch', 'totalAmount', 'currency',
          'basketSelections', 'editCount'
        ])
        && order.uid == request.auth.uid
        && order.email == email
        && order.employeeCode == roster.get('employeeCode', '')
        && profile.email == email
        && profile.employeeCode == order.employeeCode
        && profile.company == roster.get('company', '')
        && profile.get('monthlySpendingLimit', -1)
          == roster.get('monthlySpendingLimit', -1)
        && profile.get('currentMonthlySpent', 0) == oldSpent
        && profile.get('spendingPeriod', '') == roster.get('spendingPeriod', '')
        && (!roster.keys().hasAny(['monthlySpendingLimit'])
          || roster.monthlySpendingLimit == 0
          || (totalAmount is number
            && totalAmount >= 0
            && totalAmount <= roster.monthlySpendingLimit - oldSpent))
        && (!order.keys().hasAny(['totalAmount'])
          || (totalAmount is number && totalAmount >= 0 && order.currency == 'YER'))
        && (!order.keys().hasAny(['pickupBranch'])
          || (order.pickupBranch is string
            && order.pickupBranch.size() > 0
            && order.pickupBranch.size() <= 80))
        && (!order.keys().hasAny(['totalAmount'])
          || (afterRoster.get('currentMonthlySpent', 0) == oldSpent + totalAmount
            && afterRoster.lastSpendOrderId == orderId))
        && validBaskets
        && order.items is map
        && order.items.size() <= 50
        && order.itemDetails is map
        && order.itemDetails.size() <= 50
        && order.excluded is list
        && order.excluded.size() <= 50
        && order.status == 'received'
        && order.get('editCount', 0) == 0
        && order.createdAt == request.time
        && order.updatedAt == request.time;
    }

    function validEmployeeOrderEdit(orderId) {
      let order = request.resource.data;
      let previousOrder = resource.data;
      let email = employeeEmail();
      let employeePath = rosterPathFor(email);
      let roster = get(employeePath).data;
      let afterRoster = getAfter(employeePath).data;
      let profile = order.profile;
      let totalAmount = order.get('totalAmount', -1);
      let validBaskets = order.keys().hasAny(['basketSelections'])
        ? validBasketSelection(order.basketSelections, order.baskets)
        : validBasketCounts(order.baskets);
      return isApprovedEmployeeForEmail(email)
        && (previousOrder.uid == request.auth.uid || previousOrder.email == email)
        && previousOrder.employeeCode == roster.get('employeeCode', '')
        && previousOrder.status == 'received'
        && order.status == previousOrder.status
        && order.diff(previousOrder).affectedKeys().hasOnly([
          'baskets', 'items', 'itemDetails', 'excluded', 'updatedAt',
          'pickupBranch', 'totalAmount', 'currency', 'basketSelections',
          'profile', 'editCount'
        ])
        && previousOrder.get('editCount', 0) == 0
        && order.editCount == 1
        && profile.diff(previousOrder.profile).affectedKeys().hasOnly([
          'currentMonthlySpent', 'spendingPeriod', 'monthlySpendingLimit'
        ])
        && profile.get('email', '') == email
        && profile.get('employeeCode', '') == previousOrder.employeeCode
        && profile.get('company', '') == roster.get('company', '')
        && profile.get('currentMonthlySpent', 0)
          == roster.get('currentMonthlySpent', 0)
        && profile.get('spendingPeriod', '') == afterRoster.get('spendingPeriod', '')
        && profile.get('monthlySpendingLimit', -1)
          == roster.get('monthlySpendingLimit', -1)
        && validBaskets
        && order.items is map
        && order.items.size() <= 50
        && order.excluded is list
        && order.excluded.size() <= 50
        && (!roster.keys().hasAny(['monthlySpendingLimit'])
          || roster.monthlySpendingLimit == 0
          || (totalAmount is number
            && totalAmount >= 0
            && totalAmount <= roster.monthlySpendingLimit
              - roster.get('currentMonthlySpent', 0)
              + previousOrder.get('totalAmount', 0)))
        && (!order.keys().hasAny(['totalAmount'])
          || (profile.get('currentMonthlySpent', 0)
              == roster.get('currentMonthlySpent', 0)
            && afterRoster.get('currentMonthlySpent', 0)
              == roster.get('currentMonthlySpent', 0)
                + totalAmount - previousOrder.get('totalAmount', 0)
            && afterRoster.lastSpendOrderId == orderId))
        && order.updatedAt == request.time;
    }

    match /basket_types/{basketId} {
      allow get, list: if isAdmin() || isApprovedEmployee();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll([
          'name', 'kind', 'description', 'maxPerEmployee', 'productIds', 'active'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'kind', 'description', 'maxPerEmployee', 'productIds', 'active',
          'includedSubcategories', 'excludedProductIds', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.kind in ['essential', 'family', 'custom']
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 160
        && request.resource.data.maxPerEmployee is int
        && request.resource.data.maxPerEmployee >= 0
        && request.resource.data.maxPerEmployee <= 2
        && request.resource.data.productIds is list
        && request.resource.data.productIds.size() <= 50
        && (!request.resource.data.keys().hasAny(['includedSubcategories'])
          || (request.resource.data.includedSubcategories is list
            && request.resource.data.includedSubcategories.size() <= 60))
        && (!request.resource.data.keys().hasAny(['excludedProductIds'])
          || (request.resource.data.excludedProductIds is list
            && request.resource.data.excludedProductIds.size() <= 50))
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow get, list: if isAdmin()
        || (signedIn()
          && isApprovedEmployee()
          && (resource.data.uid == request.auth.uid
            || resource.data.email == employeeEmail()));

      allow create: if signedIn() && validOrderCreate(orderId);

      allow update: if isAdmin()
        ? request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in [
            'received', 'preparing', 'ready', 'fulfilled', 'cancelled', 'deleted'
          ]
          && request.resource.data.updatedAt == request.time
          && getAfter(
            /databases/$(database)/documents/order_notifications/$(orderId)
          ).data.status == 'pending'
          && getAfter(
            /databases/$(database)/documents/order_notifications/$(orderId)
          ).data.eventStatus == request.resource.data.status
        : signedIn() && validEmployeeOrderEdit(orderId);

      allow delete: if isAdmin();
    }

    match /order_notifications/{orderId} {
      allow get, list: if isAdmin()
        || (signedIn()
          && isApprovedEmployee()
          && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'orderId', 'uid', 'status', 'eventStatus', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.orderId == orderId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && (!request.resource.data.keys().hasAny(['eventStatus'])
          || request.resource.data.eventStatus == 'received')
        && request.resource.data.createdAt == request.time
        && getAfter(
          /databases/$(database)/documents/orders/$(orderId)
        ).data.uid == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/orders/$(orderId)
        ).data.status == 'received'
        && getAfter(
          /databases/$(database)/documents/orders/$(orderId)
        ).data.email == employeeEmail()
        && (!request.resource.data.keys().hasAny(['updatedAt'])
          || request.resource.data.updatedAt == request.time);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'orderId', 'uid', 'status', 'eventStatus', 'emailSentAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.orderId == orderId
        && request.resource.data.status == 'pending'
        && request.resource.data.eventStatus == getAfter(
          /databases/$(database)/documents/orders/$(orderId)
        ).data.status
        && request.resource.data.uid == getAfter(
          /databases/$(database)/documents/orders/$(orderId)
        ).data.uid
        && getAfter(
          /databases/$(database)/documents/orders/$(orderId)
        ).data.updatedAt == request.time
        && request.resource.data.emailSentAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'orderId', 'uid', 'email', 'status', 'eventStatus', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.orderId == orderId
        && request.resource.data.uid is string
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.status == 'pending'
        && request.resource.data.eventStatus == 'deleted'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'eventStatus', 'email', 'updatedAt'])
        && request.resource.data.status == 'pending'
        && (request.resource.data.eventStatus == 'deleted'
          ? !existsAfter(
              /databases/$(database)/documents/orders/$(orderId)
            )
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.email is string
            && request.resource.data.email.size() <= 254
          : request.resource.data.eventStatus == getAfter(
              /databases/$(database)/documents/orders/$(orderId)
            ).data.status
            && request.resource.data.uid == getAfter(
              /databases/$(database)/documents/orders/$(orderId)
            ).data.uid
            && getAfter(
              /databases/$(database)/documents/orders/$(orderId)
            ).data.updatedAt == request.time)
        && request.resource.data.updatedAt == request.time)
        || (signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'eventStatus', 'createdAt', 'updatedAt'])
          && request.resource.data.status == 'pending'
          && request.resource.data.eventStatus == 'received'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && get(
            /databases/$(database)/documents/orders/$(orderId)
          ).data.uid == request.auth.uid
          && get(
            /databases/$(database)/documents/orders/$(orderId)
          ).data.status == 'received');
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'eventStatus', 'updatedAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.eventStatus == 'deleted'
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /push_tokens/{tokenId} {
      allow get: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin();
      allow create: if signedIn()
        && (isAdmin() || isApprovedEmployee())
        && tokenId.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasAll(['uid', 'token', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'token', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 100
        && request.resource.data.token.size() <= 4096
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && (isAdmin() || isApprovedEmployee())
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'token', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'token', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 100
        && request.resource.data.token.size() <= 4096
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin()
        || (signedIn()
          && isApprovedEmployee()
          && resource.data.uid == request.auth.uid);
    }

    match /employee_sync_queue/{email} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        || (signedIn()
          && isApprovedEmployee()
          && employeeEmail() == email
          && request.resource.data.keys().hasOnly(['email', 'status', 'updatedAt'])
          && request.resource.data.email == employeeEmail()
          && request.resource.data.status == 'pending'
          && request.resource.data.updatedAt == request.time);
      allow update: if isAdmin()
        || (signedIn()
          && isApprovedEmployee()
          && employeeEmail() == email
          && request.resource.data.keys().hasAll(['email', 'status', 'updatedAt'])
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['email', 'status', 'updatedAt'])
          && request.resource.data.email == employeeEmail()
          && request.resource.data.status == 'pending'
          && request.resource.data.updatedAt == request.time);
      allow delete: if isAdmin();
    }

    match /profile_change_requests/{requestId} {
      allow get, list: if isAdmin();
      allow create: if signedIn()
        && isApprovedEmployee()
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'employeeCode', 'message', 'status', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == employeeEmail()
        && request.resource.data.employeeCode == get(rosterPath()).data.employeeCode
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.status == 'reviewed'
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;
      allow delete: if isAdmin();
    }

    match /order_action_requests/{requestId} {
      allow get: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin();
      allow create: if signedIn()
        && isApprovedEmployee()
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'employeeCode', 'orderId', 'reference',
          'action', 'message', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'employeeCode', 'orderId', 'reference',
          'action', 'message', 'status', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == employeeEmail()
        && request.resource.data.employeeCode == get(rosterPath()).data.employeeCode
        && request.resource.data.orderId is string
        && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.uid
          == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.email
          == employeeEmail()
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status
          in ['received', 'preparing', 'ready']
        && request.resource.data.reference
          == get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.reference
        && request.resource.data.action in ['edit', 'delete']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.status in ['reviewed', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;
      allow delete: if isAdmin();
    }

    match /admin_settings/{settingId} {
      allow read: if (isAdmin() && settingId in [
          'order_delivery', 'organization_options', 'payment_instructions', 'basket_selection', 'support_contact'
        ])
        || (isApprovedEmployee() && settingId in [
          'organization_options', 'payment_instructions', 'basket_selection', 'support_contact'
        ]);
      allow create, update: if isAdmin() && settingId == 'order_delivery'
        && request.resource.data.keys().hasAll([
          'notificationEmails', 'spreadsheetUrl', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'notificationEmails', 'spreadsheetUrl', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.notificationEmails is list
        && request.resource.data.notificationEmails.size() <= 20
        && request.resource.data.spreadsheetUrl is string
        && request.resource.data.spreadsheetUrl.size() <= 500
        && request.resource.data.updatedBy == request.auth.uid;
      allow create, update: if isAdmin() && settingId == 'organization_options'
        && request.resource.data.keys().hasAll([
          'companies', 'branches', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'companies', 'branches', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.companies is list
        && request.resource.data.companies.size() > 0
        && request.resource.data.companies.size() <= 50
        && request.resource.data.companies[0] is map
        && request.resource.data.companies[0].keys().hasOnly(['name', 'branches'])
        && request.resource.data.companies[0].name is string
        && request.resource.data.companies[0].name.size() > 0
        && request.resource.data.companies[0].name.size() <= 80
        && request.resource.data.companies[0].branches is list
        && request.resource.data.companies[0].branches.size() > 0
        && request.resource.data.companies[0].branches.size() <= 50
        && request.resource.data.branches is list
        && request.resource.data.branches.size() > 0
        && request.resource.data.branches.size() <= 50
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow create, update: if isAdmin() && settingId == 'payment_instructions'
        && request.resource.data.keys().hasAll(['instructions', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['instructions', 'updatedAt', 'updatedBy'])
        && request.resource.data.instructions is string
        && request.resource.data.instructions.size() <= 1200
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow create, update: if isAdmin() && settingId == 'basket_selection'
        && request.resource.data.keys().hasAll(['maxTotalPerEmployee', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['maxTotalPerEmployee', 'updatedAt', 'updatedBy'])
        && request.resource.data.maxTotalPerEmployee is int
        && request.resource.data.maxTotalPerEmployee >= 1
        && request.resource.data.maxTotalPerEmployee <= 2
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow create, update: if isAdmin() && settingId == 'support_contact'
        && request.resource.data.keys().hasAll(['phone', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['phone', 'updatedAt', 'updatedBy'])
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 24
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
  }
}
